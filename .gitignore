# -- Data directories (too large for GitHub) --------------------------------
# Place study-area data in these folders locally; they are NOT tracked.
# A few small files inside them ARE tracked, because the workflow does not run
# without them (note the trailing /*, so git still descends into the folder):
#   basins/_template/config.toml   the template every prep script renders from
#   statewide/bps_lookup.json      LANDFIRE class names + colours (180 KB)
#   basins/053_PineValley/source/  the cookbook's reference dataset (see bottom)
statewide/*
!statewide/bps_lookup.json
basins/*
!basins/_template/
Humboldt_Data/RASTERS/
Humboldt_Data/SHAPEFILE/*
!Humboldt_Data/SHAPEFILE/Read_Me.txt

# -- Output (regenerated by running the workflow) ---------------------------
output/
cross_basin_summary.csv

# -- Raster and geospatial data files --------------------------------------
*.tif
*.tiff
*.tif.aux.xml
*.tiff.aux.xml
*.img
*.hdf
*.nc
*.aux.xml
*.ovr

# -- Shapefiles ------------------------------------------------------------
# The NWI_Investigations_EPSG_32611 shapefile at the repo root IS tracked (negated below).
# Data shapefiles live in the ignored study-area folders above.
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.qix
*.shp.xml

# -- Force-include the NWI shapefile (needed for basin boundary masks) -----
!NWI_Investigations_EPSG_32611.shp
!NWI_Investigations_EPSG_32611.shx
!NWI_Investigations_EPSG_32611.dbf
!NWI_Investigations_EPSG_32611.prj
!NWI_Investigations_EPSG_32611.cpg
!NWI_Investigations_EPSG_32611.qix
!NWI_Investigations_EPSG_32611.shp.xml

# -- Python -----------------------------------------------------------------
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
.env
.venv/
env/
venv/

# -- OS junk ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -- IDE / editor ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -- Misc ------------------------------------------------------------------
*.zip
*.log
*.csv
*.xlsx
*.xml

# -- Pine Valley reference dataset -----------------------------------------
# COOKBOOK_PineValley.md runs against these files, so they ship with the repo
# (about 3.3 MB total). Only the raw inputs are tracked; config.toml, input/
# and output/ for this basin are regenerated by the prep and fill scripts.
!basins/053_PineValley/
basins/053_PineValley/*
!basins/053_PineValley/source/
basins/053_PineValley/source/*
!basins/053_PineValley/source/HA053_NV_phreats_MASTER_v11_PineValley_053_w_ag_etg_adj_long_term_median_ft_1984_2025.tif
!basins/053_PineValley/source/NV_phreats_MASTER_v11_PineValley_053_w_ag.shp
!basins/053_PineValley/source/NV_phreats_MASTER_v11_PineValley_053_w_ag.shx
!basins/053_PineValley/source/NV_phreats_MASTER_v11_PineValley_053_w_ag.dbf
!basins/053_PineValley/source/NV_phreats_MASTER_v11_PineValley_053_w_ag.prj
!basins/053_PineValley/source/NV_phreats_MASTER_v11_PineValley_053_w_ag.cpg
